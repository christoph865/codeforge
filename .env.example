# --- LLM provider ---
# "claude" needs a paid Anthropic key. "gemini" has a genuine free tier (no billing setup
# required) — get a key at https://aistudio.google.com/apikey. Good for testing for free.
LLM_PROVIDER=claude

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

# Cost/abuse guardrail: max LLM calls per pipeline run (CLI) or per server session (MCP).
MAX_LLM_CALLS_PER_RUN=20

# --- GitLab ---
# Personal/project access token, SCOPED to api + write_repository only. Never use an admin/root token.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=00000000

# --- Reliability ---
# Applied to both the Claude and GitLab clients.
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# --- Safety ---
# When true, no writes are sent to GitLab (branches/commits/MRs/comments are logged, not executed).
DRY_RUN=true

# --- Audit log location ---
AUDIT_LOG_PATH=.codeforge/audit.log
