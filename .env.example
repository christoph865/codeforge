# --- LLM provider (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- GitLab ---
# Personal/project access token, SCOPED to api + write_repository only. Never use an admin/root token.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=00000000

# --- Safety ---
# When true, no writes are sent to GitLab (branches/commits/MRs/comments are logged, not executed).
DRY_RUN=true

# --- Audit log location ---
AUDIT_LOG_PATH=.codeforge/audit.log
